# ============================================================
#  .gitignore – Java / Maven / Playwright
# ============================================================

# ── Maven build output ──────────────────────────────────────
target/

# ── IDE files ───────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
*.class

# ── VS Code ─────────────────────────────────────────────────
.vscode/

# ── Playwright artefacts (committed only when debugging) ────
test-results/
playwright-report/

# ── OS generated files ──────────────────────────────────────
.DS_Store
Thumbs.db

# ── Environment / secrets ───────────────────────────────────
.env
*.secret
